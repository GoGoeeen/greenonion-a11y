{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "allowJs": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "*.js"]
}
